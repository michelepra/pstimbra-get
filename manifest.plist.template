<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template del manifest OTA per l'installazione ad-hoc dell'IPA su iOS
  (Safari non installa un .ipa scaricato direttamente: serve questo
  manifest, aperto via link "itms-services://", vedi README "Pubblicare
  una release iOS (IPA)").

  Uso, per ogni release:
    1. Crea la release su GitHub con il tag (es. v1.3.0), carica SOLO
       l'.ipa come asset, salva come bozza (non pubblicare ancora).
    2. Copia l'URL "browser_download_url" dell'asset .ipa appena caricato
       (visibile nella pagina della bozza di release, o via
       `gh release view TAG` (campo assets, formato JSON)).
    3. Sostituisci qui sotto REPLACE_WITH_IPA_ASSET_URL con quell'URL e
       REPLACE_WITH_VERSION con la versione (es. 1.3.0, stessa del tag
       senza "v" e dello stesso valore di `version:` in pubspec.yaml).
    4. Salva il file come "manifest.plist" e caricalo come secondo asset
       della stessa release.
    5. Pubblica la release.
  index.html individua da solo l'.ipa + il manifest.plist e mostra il
  pulsante "Scarica per iOS" con il link itms-services corretto.
-->
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>assets</key>
      <array>
        <dict>
          <key>kind</key>
          <string>software-package</string>
          <key>url</key>
          <string>REPLACE_WITH_IPA_ASSET_URL</string>
        </dict>
      </array>
      <key>metadata</key>
      <dict>
        <key>bundle-identifier</key>
        <string>it.michelepra.pstimbra</string>
        <key>bundle-version</key>
        <string>REPLACE_WITH_VERSION</string>
        <key>kind</key>
        <string>software</string>
        <key>title</key>
        <string>PSTimbra</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
